#### configfile: "config/config.yaml"

SAMPLES = config["samples"]
DATA = config["data_dir"]
RESULTS = config["results_dir"]

rule all:
    input:
        expand(
            RESULTS + "/{sample}_R1_fastqc.html",
            sample=SAMPLES
        ),
        expand(
            RESULTS + "/{sample}_R2_fastqc.html",
            sample=SAMPLES
        )

rule fastqc:
    input:
        r1=DATA + "/{sample}_R1.fastq.gz",
        r2=DATA + "/{sample}_R2.fastq.gz"
    output:
        html1=RESULTS + "/{sample}_R1_fastqc.html",
        html2=RESULTS + "/{sample}_R2_fastqc.html",
        zip1=RESULTS + "/{sample}_R1_fastqc.zip",
        zip2=RESULTS + "/{sample}_R2_fastqc.zip"
    log:
        "logs/{sample}_fastqc.log"
    threads:
        config["threads"]
    resources:
        mem_mb=config["memory_mb"]
    params:
        container="containers/fastqc.sif"
    shell:
        """
        apptainer exec \
            --bind "$PWD:$PWD" \
            --pwd "$PWD" \
            {params.container} \
            fastqc \
                --threads {threads} \
                --outdir {RESULTS} \
                {input.r1} {input.r2} \
                > {log} 2>&1
        """

