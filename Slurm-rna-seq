##  file 1: slurm/run_rnaseq.sbatch
#!/bin/bash
#SBATCH --job-name=rnaseq_nf
#SBATCH --partition=compute
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=02:00:00
#SBATCH --output=logs/nextflow_%j.out
#SBATCH --error=logs/nextflow_%j.err

set -euo pipefail

echo "========================================"
echo "RNA-seq Nextflow Pipeline"
echo "Job ID:      $SLURM_JOB_ID"
echo "Node:        $(hostname)"
echo "Start time:  $(date)"
echo "========================================"

# -----------------------------
# 1. Load software
# -----------------------------

module load Nextflow
module load Java

# If your HPC uses Apptainer:
module load Apptainer

nextflow -version
java -version

# -----------------------------
# 2. Define directories
# -----------------------------

PROJECT=$HOME/rna-seq-pipeline
WORK=$SCRATCH/rnaseq_nf_${SLURM_JOB_ID}
RESULTS=$PROJECT/results

mkdir -p "$WORK"
mkdir -p "$RESULTS"
mkdir -p "$PROJECT/logs"

cd "$PROJECT"

echo "Project: $PROJECT"
echo "Work:    $WORK"
echo "Results: $RESULTS"

# -----------------------------
# 3. Run Nextflow
# -----------------------------

nextflow run main.nf \
    -c conf/slurm.config \
    --reads "$PROJECT/data/*_{R1,R2}.fastq.gz" \
    --outdir "$RESULTS" \
    -work-dir "$WORK" \
    -resume

# -----------------------------
# 4. Save execution information
# -----------------------------

echo "========================================"
echo "Pipeline finished"
echo "End time: $(date)"
echo "========================================"

nextflow log

# -----------------------------
# 5. Clean temporary work
# -----------------------------

rm -rf "$WORK"

echo "Temporary work directory removed."

