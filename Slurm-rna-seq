## file 2:  conf/slurm.config
#######################################
process {
    executor = 'slurm'

    queue = 'compute'

    cpus = 2
    memory = '8 GB'
    time = '2h'

    errorStrategy = 'retry'
    maxRetries = 2

    withLabel: 'fastqc' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }

    withLabel: 'star' {
        cpus = 8
        memory = '32 GB'
        time = '8h'
    }

    withLabel: 'featurecounts' {
        cpus = 4
        memory = '16 GB'
        time = '2h'
    }
}

executor {
    name = 'slurm'
}

singularity {
    enabled = true
    autoMounts = true
}

##########################################
### next flow file 3: main.nf ############
nextflow.enable.dsl=2

params.reads  = "$baseDir/data/*_{R1,R2}.fastq.gz"
params.outdir = "$baseDir/results"

process FASTQC {

    tag "$sample_id"

    label 'fastqc'

    input:
    tuple val(sample_id), path(reads)

    output:
    path "fastqc"

    script:
    """
    mkdir -p fastqc

    fastqc \
        -t ${task.cpus} \
        -o fastqc \
        ${reads}
    """
}

process STAR {

    tag "$sample_id"

    label 'star'

    input:
    tuple val(sample_id), path(reads)

    output:
    path "${sample_id}.bam"

    script:
    """
    STAR \
        --runThreadN ${task.cpus} \
        --readFilesIn ${reads[0]} ${reads[1]} \
        --readFilesCommand zcat \
        --outSAMtype BAM SortedByCoordinate \
        --outFileNamePrefix ${sample_id}.
    """
}

workflow {

    reads_ch = Channel
        .fromFilePairs(
            params.reads,
            checkIfExists: true
        )

    FASTQC(reads_ch)

    STAR(reads_ch)
}


